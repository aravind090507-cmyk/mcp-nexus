# MCP NEXUS — STAGING ENVIRONMENT CONFIGURATION
# Production-like Isolated Staging Profile for Restricted Canary Deployment

ENVIRONMENT=Staging
DEBUG=False
VERSION=1.0.0
API_V1_PREFIX=/api/v1

# Staging Security Secret (Strictly isolated from dev/prod)
SECRET_KEY=mcp-nexus-staging-vault-supersecret-key-2026-isolated
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Staging Database (Isolated from production DB)
DATABASE_URL=sqlite:///./mcp_nexus_staging.db

# LLM Provider
LLM_PROVIDER=DEMO_DETERMINISTIC
LLM_API_KEY=
LLM_MODEL=gemini-1.5-pro

# CORS Allowed Origins
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000", "http://localhost:8000"]

# MCP Protocol & Session Management
# BASELINE: Persistent sessions remain False until explicit Phase 15D.2 authorization
ENABLE_PERSISTENT_MCP_SESSIONS=False
PERSISTENT_MCP_SERVERS=mcp-srv-erp-core
PERSISTENT_MCP_FALLBACK_TO_LEGACY=True
PERSISTENT_MCP_PREWARM_ON_STARTUP=False
MCP_HEARTBEAT_INTERVAL_SECONDS=30.0
MCP_SESSION_RECONNECT_MAX_RETRIES=3
MCP_SESSION_PING_TIMEOUT_SECONDS=5.0
