# MCP NEXUS - Environment Configuration
ENVIRONMENT=Production
DEBUG=False
PORT=8000

# Security
SECRET_KEY=mcp-nexus-enterprise-vault-supersecret-key-2026-xyz
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
DATABASE_URL=sqlite:///./mcp_nexus.db
# For PostgreSQL:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mcp_nexus

# LLM Provider Configuration
# Set to 'DEMO_DETERMINISTIC' for offline realistic autonomous workflows without external keys
# Or configure 'GEMINI', 'OPENAI', 'ANTHROPIC'
LLM_PROVIDER=DEMO_DETERMINISTIC
LLM_MODEL=gemini-1.5-pro
LLM_API_KEY=
