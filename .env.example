# ==============================================================================
# MCP NEXUS — ENTERPRISE CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to '.env' for local development, or to '.env.production' for production.

# ------------------------------------------------------------------------------
# ENVIRONMENT PROFILE
# ------------------------------------------------------------------------------
# Allowed profiles: Development | Testing | Staging | Production
ENVIRONMENT=Development
DEBUG=True
PORT=8000
WORKERS=1

# ------------------------------------------------------------------------------
# SECURITY & AUTHENTICATION
# ------------------------------------------------------------------------------
# In Production: Must be at least 32 characters, cryptographically random,
# and NOT contain default placeholder keywords ('supersecret', 'vault', 'xyz', 'default', 'changeme').
SECRET_KEY=mcp-nexus-enterprise-vault-supersecret-key-2026-xyz
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------------------------------------------------------------------------------
# DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Development: SQLite (default zero-config out-of-the-box run)
DATABASE_URL=sqlite:///./mcp_nexus.db

# Production & Clustered Concurrency: Clustered PostgreSQL is strictly mandatory!
# SQLite is rejected at startup in Production and whenever WORKERS > 1.
# DATABASE_URL=postgresql://mcp_admin:SecureProductionPassword2026@pg-cluster:5432/mcp_nexus_prod

# ------------------------------------------------------------------------------
# LLM PROVIDER & AUTONOMOUS REASONING
# ------------------------------------------------------------------------------
# Supported providers: DEMO_DETERMINISTIC | GEMINI | OPENAI | ANTHROPIC
# DEMO_DETERMINISTIC operates offline using domain correlation logic without external keys.
LLM_PROVIDER=DEMO_DETERMINISTIC
LLM_MODEL=gemini-1.5-pro
# Required in Production when using GEMINI, OPENAI, or ANTHROPIC:
LLM_API_KEY=

# ------------------------------------------------------------------------------
# MODEL CONTEXT PROTOCOL (MCP) SESSION MANAGEMENT
# ------------------------------------------------------------------------------
# Persistent sessions remain strictly opt-in and disabled by default.
ENABLE_PERSISTENT_MCP_SESSIONS=False
PERSISTENT_MCP_SERVERS=
PERSISTENT_MCP_FALLBACK_TO_LEGACY=True
PERSISTENT_MCP_PREWARM_ON_STARTUP=False
MCP_HEARTBEAT_INTERVAL_SECONDS=30.0
MCP_SESSION_RECONNECT_MAX_RETRIES=3
MCP_SESSION_PING_TIMEOUT_SECONDS=5.0
